# Install Nginx
sudo dnf install -y nginx

# Start and Enable Nginx
sudo systemctl enable --now nginx

# Enable Firewalld
sudo firewalld-cmd --permanent --add-service=http

# Check Ngiinx status
systemctl status nginx --no-pager
systemctl status nginx


